        .map(
          (s) =>
            `<option value="${s.sectorId}">${escapeHtml(s.name)}${s.code ? " (" + escapeHtml(s.code) + ")" : ""}</option>`,
        )
        .join("")
    : `<option value="">لا توجد قطاعات متاحة</option>`;

      ? `<div class="text-danger" style="padding:1rem;text-align:center"><strong>تعذر التحميل</strong><br>${msg}</div>`
      : `<div class="text-muted" style="padding:1rem;text-align:center">${msg}</div>`;
  }

  async function loadCostControl() {

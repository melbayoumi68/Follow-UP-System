    erpApi?.sectors?.create
      ? erpApi.sectors.create(payload)
      : erpApi.request("/sectors", { method: "POST", body: JSON.stringify(payload) }),
};
const sectorManagersApi = {
  create: (payload) =>
    erpApi?.sectorManagers?.create
      ? erpApi.sectorManagers.create(payload)
      : erpApi.request("/sector-managers", { method: "POST", body: JSON.stringify(payload) }),
};



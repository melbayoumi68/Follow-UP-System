<file path="wwwroot/css/dashboard-charts.css">
/* Dashboard charts — loaded AFTER site.css and mobile-fix.css */

#dashboardView .mc-disbursement-layout {
    display: grid;
    grid-template-columns: minmax(0, 3.25fr) minmax(270px, 1fr);
    gap: 0.55rem;
    align-items: stretch;
    direction: ltr;
    min-width: 0;
}
#dashboardView .mc-dashboard-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 0 0.7rem;
    padding: 0.22rem;
    overflow: visible;
    border: 1px solid #d9deea;
    border-radius: 9px;
    background: #f6f9fd;
    direction: ltr;
}
#dashboardView .mc-dashboard-tab {
    flex: initial;
    width: 100%;
    min-width: 0;
    min-height: 40px;
    padding: 0.48rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #46586b;
    font: 700 0.88rem/1.2 Tahoma, "Segoe UI", sans-serif;
    cursor: pointer;
    transition: background-color .16s ease, color .16s ease, border-color .16s ease, box-shadow .16s ease;
}
#dashboardView .mc-dashboard-tab:hover { background: #eaf3fc; color: #1c4f7a; }
#dashboardView .mc-dashboard-tab[aria-selected="true"] {
    border-color: #c7ddf3;
    background: #fff;
    color: #174f7d;
    box-shadow: 0 1px 3px rgba(26, 67, 102, .1);
}
#dashboardView .mc-dashboard-tab:focus-visible { outline: 2px solid #3184c6; outline-offset: 2px; }
#dashboardView .mc-dashboard-tab-panel[hidden] { display: none !important; }
#dashboardView .mc-dashboard-tab-panel[data-dashboard-panel="progress"],
#dashboardView .mc-dashboard-tab-panel[data-dashboard-panel="contracts"] {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
}
#dashboardView .mc-dashboard-tab-panel[data-dashboard-panel="invoices"] { min-width: 0; }
#dashboardView .mc-restored-dashboard-charts { grid-template-columns: minmax(0, 1fr); }
#dashboardView .mc-disbursement-section > .mc-section-head,
#dashboardView .mc-disbursement-section > .mc-gap-strip { display: none; }

#dashboardView .mc-disbursement-section {
    padding: 0.7rem;
}
#dashboardView .mc-disbursement-section > .mc-section-head,
#dashboardView .mc-disbursement-section > .mc-gap-strip {
    display: none;
}
#dashboardView .mc-disbursement-main,
#dashboardView .mc-disbursement-side {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    min-width: 0;
    direction: rtl;
}
#dashboardView .mc-disbursement-side {
    grid-template-rows: auto minmax(0, 1fr);
}
#dashboardView .mc-disbursement-monthly-card,
#dashboardView .mc-disbursement-table-card,
#dashboardView .mc-manager-disbursement-card,
#dashboardView .mc-pending-count-card {
    padding: 0;
    margin: 0;
    border: 1px solid #d9deea;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    overflow: hidden;
    min-width: 0;
}
#dashboardView .mc-disbursement-monthly-card .mc-chart-header,
#dashboardView .mc-disbursement-table-card .mc-chart-header,
#dashboardView .mc-manager-disbursement-card .mc-chart-header {
    min-height: 31px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem 0.65rem;
    background: #a9d4ff;
    border-bottom: 1px solid #8fc4f8;
    color: #152a3d;
    font-size: 0.82rem;
    font-weight: 800;
    text-align: center;
}
#dashboardView .mc-disbursement-monthly-body {
    height: 268px;
    box-sizing: border-box;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    direction: ltr;
    padding: 0.15rem 0.2rem 0.1rem;
    -webkit-overflow-scrolling: touch;
}
#dashboardView .mc-disbursement-monthly-inner {
    position: relative;
    min-width: 100%;
    height: 100%;
}
#dashboardView .mc-disbursement-monthly-inner canvas,
#dashboardView .mc-manager-disbursement-inner canvas {
    display: block;
}
#dashboardView .mc-pending-count-card {
    min-height: 74px;
    padding: 0.45rem 0.65rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.12rem;
}
#dashboardView .mc-pending-count-value {
    color: #27313b;
    font-size: 1.55rem;
    line-height: 1.1;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
}
#dashboardView .mc-pending-count-label {
    color: #9b4f2b;
    font-size: 0.78rem;
    font-weight: 700;
}
#dashboardView .mc-manager-disbursement-card {
    display: flex;
    flex-direction: column;
    min-height: 0;
}
#dashboardView .mc-manager-disbursement-body {
    height: 560px;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.25rem 0.2rem 0.35rem;
    direction: ltr;
    scrollbar-gutter: stable;
}
#dashboardView .mc-manager-disbursement-inner {
    position: relative;
    width: 100%;
    min-height: 100%;
}
#dashboardView .mc-disbursement-table-wrap {
    width: 100%;
    max-height: 280px;
    overflow: auto;
    direction: rtl;
    -webkit-overflow-scrolling: touch;
}
#dashboardView .mc-disbursement-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    table-layout: fixed;
    direction: rtl;
    color: #24313d;
    font-size: 0.8rem;
}
#dashboardView .mc-disbursement-table .mc-invoice-number-col { width: 23%; }
#dashboardView .mc-disbursement-table .mc-expected-col,
#dashboardView .mc-disbursement-table .mc-actual-col { width: 18%; }
#dashboardView .mc-disbursement-table .mc-manager-col { width: 41%; }
#dashboardView .mc-disbursement-table th:nth-child(1),
#dashboardView .mc-disbursement-table td:nth-child(1) { width: 23%; }
#dashboardView .mc-disbursement-table th:nth-child(2),
#dashboardView .mc-disbursement-table td:nth-child(2),
#dashboardView .mc-disbursement-table th:nth-child(3),
#dashboardView .mc-disbursement-table td:nth-child(3) { width: 18%; }
#dashboardView .mc-disbursement-table th:nth-child(4),
#dashboardView .mc-disbursement-table td:nth-child(4) { width: 41%; }
#dashboardView .mc-disbursement-table th,
#dashboardView .mc-disbursement-table td {
    padding: 0.32rem 0.4rem;
    border: 1px solid #d9dde3;
    text-align: right;
    vertical-align: middle;
    overflow-wrap: anywhere;
}
#dashboardView .mc-disbursement-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #f8fbff;
    color: #172c40;
    font-weight: 700;
    white-space: nowrap;
}
#dashboardView .mc-disbursement-table thead th:nth-child(2),
#dashboardView .mc-disbursement-table thead th:nth-child(3) {
    background: #e7f3ff;
    border-bottom-color: #8fc4f8;
    color: #164b78;
    font-size: 0.84rem;
}
#dashboardView .mc-disbursement-table thead th:nth-child(2) { border-inline-end: 0; }
#dashboardView .mc-disbursement-table thead th:nth-child(3) { border-inline-start: 0; }
#dashboardView .mc-disbursement-table tbody tr:nth-child(even) { background: #ededed; }
#dashboardView .mc-disbursement-table td:nth-child(1),
#dashboardView .mc-disbursement-table td:nth-child(2),
#dashboardView .mc-disbursement-table td:nth-child(3) {
    white-space: nowrap;
    text-align: center;
    font-variant-numeric: tabular-nums;
}
#dashboardView .mc-disbursement-table tbody td:nth-child(2),
#dashboardView .mc-disbursement-table tbody td:nth-child(3) {
    background: #f3f8fd;
    color: #1d3448;
    font-size: 0.84rem;
    font-weight: 700;
}
#dashboardView .mc-disbursement-table tbody tr:nth-child(even) td:nth-child(2),
#dashboardView .mc-disbursement-table tbody tr:nth-child(even) td:nth-child(3) { background: #eaf2f9; }
#dashboardView .mc-disbursement-table tbody td:nth-child(2) { border-inline-end: 0; }
#dashboardView .mc-disbursement-table tbody td:nth-child(3) { border-inline-start: 0; }
#dashboardView .mc-disbursement-table td:nth-child(4) { min-width: 130px; }
#dashboardView .mc-disbursement-table tfoot th {
    position: sticky;
    bottom: 0;
    z-index: 4;
    background: #fff;
    border-top: 1px solid #8fc4f8;
    font-weight: 800;
}
#dashboardView .mc-disbursement-table tfoot th:nth-child(2),
#dashboardView .mc-disbursement-table tfoot th:nth-child(3) { text-align: center; direction: ltr; }

@media (max-width: 1050px) {
    #dashboardView .mc-disbursement-layout { grid-template-columns: minmax(0, 1fr); }
    #dashboardView .mc-disbursement-side { grid-template-columns: minmax(150px, 0.4fr) minmax(0, 1fr); grid-template-rows: auto; }
    #dashboardView .mc-manager-disbursement-body { height: 420px; }
}
@media (max-width: 640px) {
    #dashboardView .mc-dashboard-tabs { margin-bottom: 0.55rem; }
    #dashboardView .mc-dashboard-tab { min-height: 46px; font-size: 0.94rem; }
    #dashboardView .mc-disbursement-side { grid-template-columns: minmax(0, 1fr); }
    #dashboardView .mc-disbursement-monthly-body { height: 290px; }
    #dashboardView .mc-manager-disbursement-body { height: 430px; }
    #dashboardView .mc-disbursement-table-wrap { max-height: 320px; }
    #dashboardView .mc-disbursement-table { min-width: 680px; font-size: 0.76rem; }
    #dashboardView .mc-disbursement-table thead th:nth-child(2),
    #dashboardView .mc-disbursement-table thead th:nth-child(3),
    #dashboardView .mc-disbursement-table tbody td:nth-child(2),
    #dashboardView .mc-disbursement-table tbody td:nth-child(3) { font-size: 0.8rem; }
}

#dashboardView .mc-chart-card {
    padding: 0;
    margin: 0;
    border: 1px solid #d9deea;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
}

#dashboardView .mc-chart-header {
    background: #9dceff;
    color: #0f172a;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 800;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid #86bfff;
}

#dashboardView .mc-chart-body {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: 380px;
    padding: 0.75rem 0.75rem 0.5rem;
}

#dashboardView .mc-chart-body canvas {
    display: block;
}

/* Horizontal scroll for the monthly chart (scroll stays inside the card) */
#dashboardView .mc-chart-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    direction: ltr;
    -webkit-overflow-scrolling: touch;
}

#dashboardView .mc-chart-scroll-inner {
    position: relative;
    height: 100%;
    min-width: 100%;
}

#dashboardView .mc-comparison-row {
    display: grid;
    grid-template-columns: minmax(0, 3.2fr) minmax(250px, 1fr);
    gap: 0.75rem;
    min-width: 0;
    align-items: stretch;
    direction: ltr;
}

#dashboardView .mc-chart-primary,

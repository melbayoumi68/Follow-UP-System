}

async function saveSectorManager() {
  if (!assertCan("projects", "create", "حفظ مدير القطاع")) return;
  const fullName = document.getElementById("sectorManagerFullName").value.trim();
  const sectorId = parseInt(document.getElementById("sectorManagerSectorId").value, 10);

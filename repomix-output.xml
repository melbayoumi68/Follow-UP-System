    color: #fff;
    font-size: 1.32rem;
    font-weight: 800;
    letter-spacing: -.01em;
}
#dashboardView .dashboard-toolbar-sub {
    color: rgba(226,236,252,.72);
    font-size: .82rem;
    margin-top: .3rem;
    letter-spacing: .01em;
}
#dashboardView .mc-header-actions {
    display: flex;
    align-items: center;
    gap: .9rem;
    flex-wrap: wrap;
    justify-content: flex-end;
}
#dashboardView .mc-last-updated {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
